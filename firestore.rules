rules_version = '2';

// =============================================================================
//  Interrogazioni 4T SSA – Firestore Security Rules
// =============================================================================
//  Principi:
//   • Tutto è NEGATO di default. Si apre solo ciò che è scritto qui sotto.
//   • Il "permesso" di un account è il documento users/{uid}. Un account Firebase
//     Auth senza quel documento non può leggere né scrivere nulla (tranne
//     completare la propria attivazione con un token d'invito valido).
//   • users/{uid} con role=='admin' si crea SOLO a mano dalla console Firebase.
//     Il client non può mai darsi il ruolo admin.
//   • Studente: modifica i gruppi SOLO tramite uno scambio che
//       1. lui stesso (destinatario) accetta,
//       2. era stato richiesto dall'altro studente (creato con regole valide),
//       3. cambia soltanto i due posti coinvolti, scambiandoli esattamente.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helper --
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function groupPath(id) { return /databases/$(database)/documents/groups/$(id); }
    function swapPath(id) { return /databases/$(database)/documents/swaps/$(id); }
    function studentPath(id) { return /databases/$(database)/documents/students/$(id); }
    function invitePath(id) { return /databases/$(database)/documents/invites/$(id); }

    // L'utente ha un "permesso" (documento users/{uid})?
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function profile() { return get(userPath(request.auth.uid)).data; }
    function isAdmin() { return hasProfile() && profile().role == 'admin'; }
    function isStudent() { return hasProfile() && profile().role == 'student'; }
    function isMember() { return hasProfile(); }

    // Il giorno dell'interrogazione non è ancora iniziato (data futura, ora Italia
    // già inclusa perché startsAt è la mezzanotte locale scelta dall'admin).
    // Gruppo senza data → ancora scambiabile.
    // Programmata (materia) di un gruppo ('' per i gruppi senza pid).
    function pidOf(g) { return ('pid' in g) ? g.pid : ''; }

    function dayNotStarted(g) {
      return !('startsAt' in g) || g.startsAt == null || request.time < g.startsAt;
    }

    // ---- sostituti (usati da più punti) ------------------------------------------------------
    // Il sostituto del gruppo N sta nel gruppo N+1.
    function groupIdAt(g, n) {
      return (pidOf(g) == '' ? '' : pidOf(g) + '_') + 'g' + (n < 10 ? '0' : '') + string(n);
    }
    function pendingAt(g, i) { return g.seats.size() > i && g.seats[i] != '' && g.status[i] == 'attesa'; }
    function isPendingMember(g, sid) {
      return (pendingAt(g, 0) && g.seats[0] == sid) || (pendingAt(g, 1) && g.seats[1] == sid)
          || (pendingAt(g, 2) && g.seats[2] == sid) || (pendingAt(g, 3) && g.seats[3] == sid)
          || (pendingAt(g, 4) && g.seats[4] == sid);
    }
    function firstPendingSeat(g, absent) {
      return (pendingAt(g, 0) && !(g.seats[0] in absent)) ? g.seats[0]
        : ((pendingAt(g, 1) && !(g.seats[1] in absent)) ? g.seats[1]
        : ((pendingAt(g, 2) && !(g.seats[2] in absent)) ? g.seats[2]
        : ((pendingAt(g, 3) && !(g.seats[3] in absent)) ? g.seats[3]
        : ((pendingAt(g, 4) && !(g.seats[4] in absent)) ? g.seats[4] : ''))));
    }
    // Sostituto effettivo: quello scelto a mano (se valido) oppure il primo in attesa del gruppo dopo.
    function effectiveSub(old, next) {
      let manual = ('subId' in old) ? old.subId : '';
      let absent = ('absentIds' in old) ? old.absentIds : [];
      return (manual != '' && isPendingMember(next, manual)) ? manual : firstPendingSeat(next, absent);
    }

    // La persona che siede nel gruppo H è il sostituto effettivo del gruppo PRECEDENTE?
    // In quel caso non può cambiare gruppo finché non passa il ruolo a un compagno del suo gruppo.
    function isSubOfPrevious(h, sid) {
      return h.number > 1 && effectiveSub(get(groupPath(groupIdAt(h, h.number - 1))).data, h) == sid;
    }

    // ---------------------------------------------------------------- students --
    // Elenco pubblico dei nomi (serve alla schermata di login prima di accedere).
    // Non contiene nulla di segreto: l'email interna diventa pubblica solo dopo
    // l'attivazione, quando l'account esiste già.
    match /students/{sid} {
      allow get, list: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || activatingStudent(sid);

      // Attivazione: lo studente (non ancora con permessi) collega il suo account
      // Auth. Valida SOLO se nello stesso batch si crea users/{uid} e si consuma
      // l'invito, e se l'email dell'account coincide con quella dell'invito.
      function activatingStudent(sid) {
        let uid = request.auth.uid;
        let after = request.resource.data;
        let u = getAfter(userPath(uid)).data;
        return signedIn()
          && !exists(userPath(uid))
          && resource.data.activated == false
          && after.diff(resource.data).affectedKeys().hasOnly(['activated', 'uid', 'authEmail'])
          && after.activated == true
          && after.uid == uid
          && u.role == 'student'
          && u.studentId == sid
          && get(invitePath(u.inviteToken)).data.studentId == sid
          && get(invitePath(u.inviteToken)).data.used == false
          && get(invitePath(u.inviteToken)).data.authEmail == after.authEmail
          && request.auth.token.email == after.authEmail;
      }
    }

    // ----------------------------------------------------------------- invites --
    // Il token (id del documento) è lungo e casuale: chi lo conosce può leggere
    // quel singolo invito (get). Nessuno può elencarli, tranne l'admin.
    match /invites/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || consumingInvite(token);

      function consumingInvite(token) {
        let uid = request.auth.uid;
        return signedIn()
          && !exists(userPath(uid))
          && resource.data.used == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt', 'usedByUid'])
          && request.resource.data.used == true
          && request.resource.data.usedByUid == uid
          && getAfter(userPath(uid)).data.inviteToken == token;
      }
    }

    // ------------------------------------------------------------------- users --
    // Lo studente può creare il proprio documento SOLO durante l'attivazione.
    // Nessun update dal client. L'admin può eliminarli (reset accesso).
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if activationUserDoc(uid);
      allow delete: if isAdmin();
      allow update: if false;

      function activationUserDoc(uid) {
        let d = request.resource.data;
        let inv = get(invitePath(d.inviteToken)).data;
        return signedIn()
          && request.auth.uid == uid
          && d.keys().hasOnly(['role', 'studentId', 'inviteToken'])
          && d.role == 'student'
          && inv.studentId == d.studentId
          && inv.used == false
          && inv.authEmail == request.auth.token.email
          && getAfter(invitePath(d.inviteToken)).data.used == true
          && get(studentPath(d.studentId)).data.activated == false
          && getAfter(studentPath(d.studentId)).data.uid == uid
          && getAfter(studentPath(d.studentId)).data.activated == true
          && getAfter(studentPath(d.studentId)).data.authEmail == inv.authEmail;
      }
    }

    // ------------------------------------------------------------------ groups --
    // seats[4 o 5]  : id degli studenti ('' = posto libero)
    // status[4 o 5] : 'attesa' | 'interrogato' | 'assente'
    match /groups/{gid} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || studentSubTransfer(gid) || studentSwapWrite(gid);

      // Posto dopo lo scambio: j == posto di chi ha chiesto → ci va il destinatario
      // e viceversa; tutti gli altri posti restano uguali.
      function expSeat(oldSeats, gid, sw, j) {
        return (gid == sw.fromGroup && j == sw.fromPos) ? sw.toSid
             : ((gid == sw.toGroup && j == sw.toPos) ? sw.fromSid : oldSeats[j]);
      }

      // ---- passaggio del ruolo di SOSTITUTO ------------------------------------------------
      // Il sostituto del gruppo N sta nel gruppo N+1. Può passare il ruolo SOLO a un'altra
      // persona del suo gruppo effettivo (N+1), ancora in attesa. Cambia solo il campo subId.
      function studentSubTransfer(gid) {
        let d = request.resource.data;
        let old = resource.data;
        let next = get(groupPath(groupIdAt(old, old.number + 1))).data;
        let me = profile().studentId;
        return isStudent()
          && d.diff(old).affectedKeys().hasOnly(['subId'])
          && d.subId is string && d.subId != me
          && pidOf(next) == pidOf(old)
          && old.done != true
          && dayNotStarted(old)
          && effectiveSub(old, next) == me
          && isPendingMember(next, d.subId);
      }

      function studentSwapWrite(gid) {
        let d = request.resource.data;
        let old = resource.data;
        let sw = get(swapPath(d.lastSwapId)).data;
        return isStudent()
          && d.lastSwapId is string
          // si possono cambiare solo i posti e il riferimento allo scambio
          && d.diff(old).affectedKeys().hasOnly(['seats', 'lastSwapId'])
          // lo scambio esiste, è in attesa e nello stesso batch diventa "accepted"
          && sw.status == 'pending'
          && getAfter(swapPath(d.lastSwapId)).data.status == 'accepted'
          // lo accetta il destinatario (che è chi sta scrivendo)
          && sw.toSid == profile().studentId
          && (gid == sw.fromGroup || gid == sw.toGroup)
          // i posti sono ancora quelli della richiesta e non ancora interrogati
          && (gid != sw.fromGroup || (old.seats[sw.fromPos] == sw.fromSid && old.status[sw.fromPos] == 'attesa'))
          && (gid != sw.toGroup || (old.seats[sw.toPos] == sw.toSid && old.status[sw.toPos] == 'attesa'))
          // gruppo non fatto e data ancora futura
          && old.done != true
          && dayNotStarted(old)
          // risultato esatto
          && d.seats.size() == old.seats.size()
          && d.seats[0] == expSeat(old.seats, gid, sw, 0)
          && d.seats[1] == expSeat(old.seats, gid, sw, 1)
          && d.seats[2] == expSeat(old.seats, gid, sw, 2)
          && d.seats[3] == expSeat(old.seats, gid, sw, 3)
          // un gruppo può avere un 5° posto
          && (old.seats.size() < 5 || d.seats[4] == expSeat(old.seats, gid, sw, 4));
      }
    }

    // ------------------------------------------------------------------- swaps --
    match /swaps/{id} {
      // Le richieste sono legate agli STUDENTI (non agli account): si possono mandare anche a chi
      // non ha ancora attivato l'app; le vedrà (e potrà rispondere) appena entra.
      allow read: if isAdmin()
        || (isStudent() && (resource.data.fromSid == profile().studentId || resource.data.toSid == profile().studentId));

      // Creazione: la fa chi chiede lo scambio, con posti reali, in attesa, futuri.
      allow create: if isStudent() && validNewSwap(request.resource.data);

      // Aggiornamento di stato (solo status + resolvedAt)
      allow update: if isAdmin() || studentSwapUpdate();
      allow delete: if isAdmin();

      // Lo scambio è ancora applicabile ai gruppi come sono ADESSO?
      function swapValid(sw) {
        let ga = get(groupPath(sw.fromGroup)).data;
        let gb = get(groupPath(sw.toGroup)).data;
        return pidOf(ga) == pidOf(gb)   // si scambia solo dentro la stessa programmata
          && ga.seats[sw.fromPos] == sw.fromSid
          && gb.seats[sw.toPos] == sw.toSid
          && ga.status[sw.fromPos] == 'attesa'
          && gb.status[sw.toPos] == 'attesa'
          && ga.done != true && gb.done != true
          && dayNotStarted(ga) && dayNotStarted(gb);
      }

      function validNewSwap(d) {
        return d.keys().hasOnly(['fromSid', 'toSid', 'fromGroup', 'fromPos',
                                 'toGroup', 'toPos', 'status', 'createdAt', 'resolvedAt'])
          && d.keys().hasAll(['fromSid', 'toSid', 'fromGroup', 'fromPos',
                              'toGroup', 'toPos', 'status', 'createdAt'])
          && d.status == 'pending'
          && d.fromSid == profile().studentId
          && d.toSid is string && d.toSid != d.fromSid
          && exists(studentPath(d.toSid))
          && d.fromGroup is string && d.toGroup is string
          && d.fromPos is int && d.toPos is int
          && d.fromPos >= 0 && d.fromPos < 5 && d.toPos >= 0 && d.toPos < 5
          && d.createdAt == request.time
          && swapValid(d)
          // chi è sostituto del gruppo prima deve prima passare il ruolo
          && !isSubOfPrevious(get(groupPath(d.fromGroup)).data, d.fromSid);
      }

      function studentSwapUpdate() {
        let old = resource.data;
        let nw = request.resource.data;
        let me = profile().studentId;
        return isStudent()
          && old.status == 'pending'
          && nw.diff(old).affectedKeys().hasOnly(['status', 'resolvedAt'])
          && nw.resolvedAt == request.time
          && (
            // il destinatario ACCETTA: valido solo se i gruppi sono scambiati nello stesso batch
            (old.toSid == me && nw.status == 'accepted' && swapValid(old)
              && !isSubOfPrevious(get(groupPath(old.fromGroup)).data, old.fromSid)
              && !isSubOfPrevious(get(groupPath(old.toGroup)).data, old.toSid)
              && getAfter(groupPath(old.fromGroup)).data.seats[old.fromPos] == old.toSid
              && getAfter(groupPath(old.toGroup)).data.seats[old.toPos] == old.fromSid)
            // il destinatario RIFIUTA
            || (old.toSid == me && nw.status == 'rejected')
            // chi ha chiesto ANNULLA
            || (old.fromSid == me && nw.status == 'cancelled')
            // uno dei due segna come DECADUTA una richiesta non più applicabile
            || ((old.fromSid == me || old.toSid == me) && nw.status == 'expired' && !swapValid(old))
          );
      }
    }

    // -------------------------------------------------------------- programmate --
    // Una programmata = una materia (es. Italiano) con i suoi gruppi (groups.pid).
    // La leggono tutti gli account validi, la gestisce solo l'admin.
    match /programmate/{pid} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------- history --
    // Storico leggibile da chi ha un account. Scrive l'admin; lo studente può
    // scrivere SOLO la voce di uno scambio che sta accettando (id = id scambio),
    // con campi identici a quelli dello scambio (nessun testo libero).
    match /history/{hid} {
      allow read: if isMember();
      allow create: if isAdmin() || swapHistory(hid);
      allow update, delete: if isAdmin();

      function swapHistory(hid) {
        let d = request.resource.data;
        let before = get(swapPath(hid)).data;
        let after = getAfter(swapPath(hid)).data;
        return isStudent()
          && d.keys().hasOnly(['type', 'swapId', 'at', 'fromSid', 'toSid', 'fromGroup', 'fromPos', 'toGroup', 'toPos'])
          && d.type == 'swap'
          && d.swapId == hid
          && d.at == request.time
          && before.status == 'pending'
          && after.status == 'accepted'
          && before.toSid == profile().studentId
          && d.fromSid == before.fromSid && d.toSid == before.toSid
          && d.fromGroup == before.fromGroup && d.fromPos == before.fromPos
          && d.toGroup == before.toGroup && d.toPos == before.toPos;
      }
    }
  }
}
