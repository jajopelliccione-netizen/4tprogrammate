# Copia questo file in ".env" e incolla i valori del tuo progetto Firebase
# (Console Firebase → Impostazioni progetto → Le tue app → App web → "Configurazione SDK").
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo per sviluppo locale con gli emulatori (lascia vuoto in produzione)
VITE_USE_EMULATORS=
